@'
# PostgreSQL
POSTGRES_DB=tmb_pedidos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# API
API_PORT=8080

# Frontend
FRONTEND_PORT=5173

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@tmb.local
PGADMIN_PASSWORD=admin
'@ | Set-Content -Path ".env.example" -Encoding utf8